# Funções serverless /api/projeto-lead e /api/leads (somente servidor —
# NUNCA usar prefixo VITE_). Toda a leitura/escrita de leads passa por aqui.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# (Opcional) A anon key não é mais usada para leads. Mantenha apenas se houver
# outro recurso do frontend que dependa dela.
# VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
# VITE_SUPABASE_ANON_KEY=SUA_ANON_KEY
